/*
 * KaSe split keyboard keymap — 5 rows × 7 cols per half
 *
 * Layout (from keymap.c of original firmware):
 *
 * Left:                                       Right:
 *   ESC  1    2    3    4    5    6     |     7    8    9    0    -    =    BSPC
 *   TAB  Q    W    E    R    T    ·     |     Y    U    I    O    P    [    ]
 *   CAP  A    S    D    F    G    ·     |     H    J    K    L    ;    '    ENT
 *   SFT  Z    X    C    V    ·    ·     |     N    M    ,    .    /    SFT  ·
 *   CTL  GUI  ALT  LY1  SPC  ·    ·     |     SPC  LY2  ALT  CTL  ·    ·    ·
 *
 * · = no physical key (empty matrix position)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define NAV   1
#define SYM   2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
// ╭───────┬───────┬───────┬───────┬───────┬───────┬───────╮ ╭───────┬───────┬───────┬───────┬───────┬───────┬───────╮
    &kp ESC &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6    &kp N7  &kp N8  &kp N9  &kp N0 &kp MINUS &kp EQUAL &kp BSPC
// ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤
    &kp TAB &kp Q   &kp W   &kp E   &kp R   &kp T   &none     &kp Y   &kp U   &kp I   &kp O   &kp P  &kp LBKT &kp RBKT
// ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤
   &kp CAPS &kp A   &kp S   &kp D   &kp F   &kp G   &none     &kp H   &kp J   &kp K   &kp L  &kp SEMI &kp SQT &kp RET
// ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤
   &kp LSHFT &kp Z  &kp X   &kp C   &kp V   &none   &none     &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT &none
// ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤ ├───────┼───────┼───────┼───────┼───────┼───────┼───────┤
   &kp LCTRL &kp LGUI &kp LALT &mo NAV &kp SPACE &none &none  &kp SPACE &mo SYM &kp RALT &kp RCTRL &none &none &none
// ╰───────┴───────┴───────┴───────┴───────┴───────┴───────╯ ╰───────┴───────┴───────┴───────┴───────┴───────┴───────╯
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
    &kp GRAVE &kp F1 &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &kp F12 &kp DEL
    &trans  &trans  &trans  &trans  &trans  &trans  &none      &trans &kp HOME &kp UP  &kp END &kp PG_UP &trans &trans
    &trans  &trans  &trans  &trans  &trans  &trans  &none      &trans &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &trans &trans
   &kp LSHFT &trans &trans  &trans  &trans  &none   &none      &trans  &trans  &trans  &trans  &trans &kp RSHFT &none
   &kp LCTRL &kp LGUI &kp LALT &trans &trans &none  &none      &trans  &trans &kp RALT &kp RCTRL &none &none &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
    &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans  &none      &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans  &none      &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &none   &none      &trans  &trans  &trans  &trans  &trans  &trans  &none
    &trans  &trans  &trans  &trans  &trans  &none   &none      &trans  &trans  &trans  &trans  &none   &none   &none
            >;
        };
    };
};
