/*
 * KaSe split keyboard — shared definitions
 *
 * 5 rows × 7 cols per half = 35 positions per side, 70 total
 * Reversible PCB: same design for both halves.
 *
 * Matrix wiring (row2col diode direction):
 *   Rows: output (driven LOW to scan = active-low)
 *   Cols: input (pull-up, pressed = LOW = active-low)
 *   Diodes: BAT54C (row→col)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Full matrix transform: 5 rows × 14 columns
     * Left half:  cols 0..6
     * Right half: cols 7..13 (col-offset = 7 on right)
     *
     * Physical layout:
     *   R0: ESC  1   2   3   4   5   6  |  7   8   9   0   -   =  BSPC
     *   R1: TAB  Q   W   E   R   T   ·  |  Y   U   I   O   P   [   ]
     *   R2: CAP  A   S   D   F   G   ·  |  H   J   K   L   ;   '  ENT
     *   R3: SFT  Z   X   C   V   ·   ·  |  N   M   ,   .   /  SFT  ·
     *   R4: CTL  GUI ALT LY1 SPC  ·   ·  | SPC LY2 ALT CTL  ·   ·   ·
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)    RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)    RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)    RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)    RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };

    /*
     * Key scan matrix — 5 rows × 7 cols per half
     *
     * Rows (shared, same pins both sides):
     *   ROW0 = D1  = P0.06
     *   ROW1 = D0  = P0.08
     *   ROW2 = D2  = P0.17
     *   ROW3 = D3  = P0.20
     *   ROW4 = D4  = P0.22
     *
     * Cols are set per-side in left/right overlays
     * (reversed on right due to reversible PCB flip)
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_LOW)>   /* ROW0 = D1  = P0.06 */
            , <&gpio0 8  (GPIO_ACTIVE_LOW)>   /* ROW1 = D0  = P0.08 */
            , <&gpio0 17 (GPIO_ACTIVE_LOW)>   /* ROW2 = D2  = P0.17 */
            , <&gpio0 20 (GPIO_ACTIVE_LOW)>   /* ROW3 = D3  = P0.20 */
            , <&gpio0 22 (GPIO_ACTIVE_LOW)>   /* ROW4 = D4  = P0.22 */
            ;

        /* col-gpios defined in left/right overlays */
    };
};
